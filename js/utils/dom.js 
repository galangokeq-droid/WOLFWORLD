const currencyFormatter = new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0,
});
const dateFormatter = new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short' });

export function formatCurrency(value) {
  return currencyFormatter.format(Number(value ?? 0));
}

export function formatDate(value) {
  return value ? dateFormatter.format(new Date(value)) : '-';
}

export function createElement(tag, className, text) {
  const element = document.createElement(tag);
  if (className) element.className = className;
  if (text !== undefined) element.textContent = text;
  return element;
}

export function createAlert(message, type = 'error') {
  const box = createElement('div', type === 'success' ? 'alert alert-success' : 'alert alert-error');
  box.setAttribute('role', type === 'success' ? 'status' : 'alert');
  box.textContent = message;
  return box;
}

export function createBackButton(label, onClick) {
  const button = createElement('button', 'btn btn-secondary back-button', label);
  button.type = 'button';
  button.addEventListener('click', onClick);
  return button;
}

export function createInfoRow(label, value) {
  const row = createElement('div', 'info-row');
  row.append(
    createElement('span', 'stat-label', label),
    createElement('strong', 'info-value', String(value ?? '-')),
  );
  return row;
}

export function createListRow(primary, secondary, aside) {
  const row = createElement('li', 'list-item');
  const details = createElement('div');
  details.append(createElement('strong', null, primary), createElement('div', 'stat-label', secondary));
  row.append(details, createElement('div', 'stat-label', aside));
  return row;
}

export function createEmpty(text) {
  return createElement('li', 'list-empty', text);
}